	@test -d $(DISTDIR) || mkdir -p $(DISTDIR)
	$(COPY_FILE) --parents $(DIST) $(DISTDIR)/
	$(COPY_FILE) --parents ../../glsl.qrc ../../obj.qrc $(DISTDIR)/
	$(COPY_FILE) --parents ../../src/framebuffer.h ../../src/glm_includes.h ../../src/globals.h ../../src/glslwriting.h ../../src/mainwindow.h ../../src/mygl.h /Users/Dev/Documents/PathTracer/src/scene/cube.h ../../src/scene/geometry/bvhtree.h ../../src/scene/geometry/mesh.h ../../src/scene/geometry/shape.h ../../src/scene/jsonreader.h ../../src/scene/lights/light.h ../../src/scene/materials/material.h ../../src/scene/scene.h ../../src/scene/transform.h ../../src/shaderprogram.h ../../src/stb_image.h ../../src/texture.h ../../src/tinyobj/tiny_obj_loader.h ../../src/utils.h ../../src/drawable.h ../../src/camera.h ../../src/cameracontrolshelp.h ../../src/openglcontext.h ../../src/scene/squareplane.h ../../src/smartpointerhelp.h $(DISTDIR)/
	$(COPY_FILE) --parents ../../src/cameracontrols.cpp ../../src/framebuffer.cpp ../../src/glslwriting.cpp ../../src/main.cpp ../../src/mainwindow.cpp ../../src/mygl.cpp ../../src/scene/geometry/bvhnode.cpp ../../src/scene/geometry/mesh.cpp ../../src/scene/geometry/shape.cpp ../../src/scene/jsonreader.cpp ../../src/scene/lights/light.cpp ../../src/scene/materials/material.cpp ../../src/scene/scene.cpp ../../src/scene/transform.cpp ../../src/shaderprogram.cpp ../../src/texture.cpp ../../src/tinyobj/tiny_obj_loader.cc ../../src/utils.cpp ../../src/drawable.cpp ../../src/camera.cpp ../../src/cameracontrolshelp.cpp ../../src/openglcontext.cpp ../../src/scene/squareplane.cpp $(DISTDIR)/
