	@echo "APPL????" > ShaderPathtracer.app/Contents/PkgInfo
ShaderPathtracer.app/Contents/Info.plist: 
	@test -d ShaderPathtracer.app/Contents || mkdir -p ShaderPathtracer.app/Contents
	@$(DEL_FILE) ShaderPathtracer.app/Contents/Info.plist
	@plutil -convert xml1 -o - /opt/Qt/6.9.0/macos/mkspecs/macx-clang/Info.plist.app | sed -e "s,@SHORT_VERSION@,1.0,g" -e "s,\$${QMAKE_SHORT_VERSION},1.0,g" -e "s,@FULL_VERSION@,1.0.0,g" -e "s,\$${QMAKE_FULL_VERSION},1.0.0,g" -e "s,@TYPEINFO@,????,g" -e "s,\$${QMAKE_PKGINFO_TYPEINFO},????,g" -e "s,@BUNDLEIDENTIFIER@,com.yourcompany.ShaderPathtracer,g" -e "s,\$${PRODUCT_BUNDLE_IDENTIFIER},com.yourcompany.ShaderPathtracer,g" -e "s,\$${MACOSX_DEPLOYMENT_TARGET},12,g" -e "s,\$${IPHONEOS_DEPLOYMENT_TARGET},,g" -e "s,\$${TVOS_DEPLOYMENT_TARGET},,g" -e "s,\$${WATCHOS_DEPLOYMENT_TARGET},,g" -e "s,\$${IOS_LAUNCH_SCREEN},LaunchScreen,g" -e "s,@ICON@,,g" -e "s,\$${ASSETCATALOG_COMPILER_APPICON_NAME},,g" -e "s,@EXECUTABLE@,ShaderPathtracer,g" -e "s,@LIBRARY@,ShaderPathtracer,g" -e "s,\$${EXECUTABLE_NAME},ShaderPathtracer,g" -e "s,@TYPEINFO@,????,g" -e "s,\$${QMAKE_PKGINFO_TYPEINFO},????,g" >ShaderPathtracer.app/Contents/Info.plist

